CREATE TABLE public.Appointment (
  appointment_id uuid NOT NULL DEFAULT gen_random_uuid(),
  patient_id uuid,
  doctor_id uuid,
  service_id uuid,
  appointment_datetime timestamp with time zone NOT NULL,
  status character varying NOT NULL,
  predicted_wait_time_minutes integer,
  created_at timestamp with time zone DEFAULT CURRENT_TIMESTAMP,
  payment_status text DEFAULT 'Unpaid'::text,
  payment_method text,
  notes text,
  previous_appointment_id uuid,
  custom_price numeric,
  CONSTRAINT Appointment_pkey PRIMARY KEY (appointment_id),
  CONSTRAINT Appointment_patient_id_fkey FOREIGN KEY (patient_id) REFERENCES public.Patient(patient_id),
  CONSTRAINT Appointment_doctor_id_fkey FOREIGN KEY (doctor_id) REFERENCES public.Doctor(doctor_id),
  CONSTRAINT Appointment_service_id_fkey FOREIGN KEY (service_id) REFERENCES public.Service(service_id),
  CONSTRAINT Appointment_previous_appointment_id_fkey FOREIGN KEY (previous_appointment_id) REFERENCES public.Appointment(appointment_id)
);
CREATE TABLE public.Doctor (
  doctor_id uuid NOT NULL DEFAULT gen_random_uuid(),
  specialization character varying NOT NULL,
  years_experience integer DEFAULT 0,
  name character varying,
  is_available boolean,
  CONSTRAINT Doctor_pkey PRIMARY KEY (doctor_id)
);
CREATE TABLE public.Message (
  message_id uuid NOT NULL DEFAULT gen_random_uuid(),
  sender_type character varying NOT NULL,
  sender_id uuid,
  recipient_id uuid,
  message_content text NOT NULL,
  sent_at timestamp with time zone DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT Message_pkey PRIMARY KEY (message_id)
);
CREATE TABLE public.Notification (
  notification_id uuid NOT NULL DEFAULT gen_random_uuid(),
  recipient_id uuid,
  message_content text NOT NULL,
  link character varying,
  is_read boolean DEFAULT false,
  created_at timestamp with time zone DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT Notification_pkey PRIMARY KEY (notification_id),
  CONSTRAINT Notification_recipient_id_fkey FOREIGN KEY (recipient_id) REFERENCES public.Patient(patient_id)
);
CREATE TABLE public.Patient (
  patient_id uuid NOT NULL DEFAULT gen_random_uuid(),
  name character varying NOT NULL UNIQUE,
  email character varying NOT NULL UNIQUE,
  password_hash text NOT NULL UNIQUE,
  dob date,
  phone_number character varying NOT NULL UNIQUE,
  is_oku boolean DEFAULT false,
  CONSTRAINT Patient_pkey PRIMARY KEY (patient_id)
);
CREATE TABLE public.QueueEntry (
  queue_id uuid NOT NULL DEFAULT gen_random_uuid(),
  patient_id uuid,
  doctor_id uuid,
  service_id uuid,
  check_in_time timestamp with time zone DEFAULT CURRENT_TIMESTAMP,
  queue_number integer NOT NULL,
